print("\n--- Top 10 Features Per Fold (Stability Analysis) ---")

# Convert the list of lists into a DataFrame where each column is a fold
top_features_df = pd.DataFrame(fold_top_features_list).T
top_features_df.columns = [f"Fold {i+1}" for i in range(5)]
top_features_df.index = [f"Rank {i+1}" for i in range(10)]

# Display the clean side-by-side comparison table
display(top_features_df)